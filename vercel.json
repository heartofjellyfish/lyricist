      "has": [{ "type": "host", "value": "rhyme.land" }],
      "destination": "/rhyme-finder/sitemap-pages.xml"
    },
    {
      "source": "/rhymes",
      "destination": "/rhyme-finder/rhymes/index.html"
    },
    {
      "source": "/rhymes/:path*",
