      "has": [{ "type": "host", "value": "rhyme.land" }],
      "destination": "/rhyme-finder/sitemap.xml"
    },
    {
      "source": "/sitemap-home.xml",
      "has": [{ "type": "host", "value": "rhyme.land" }],
